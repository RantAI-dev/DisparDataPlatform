# App dispar-v2 — salin ke .env.local (gitignored), lalu isi nilainya.
# Nilai asli ada di Portainer stack 6 (`dispar-lakehouse`) → Env.
# JANGAN menulis nilai asli ke berkas ini — repo ini PUBLIC.

# --- ClickHouse (lakehouse) ---
# Dari laptop, tembak host 187 langsung:
CH_URL=http://192.168.18.187:18123
CH_USER=dispar_app
CH_PASSWORD=<Portainer stack 6 → CH_APP_PASSWORD>
# Catatan: di dalam container nilainya http://lake-clickhouse:8123.
# `dispar_app` read-only. Untuk kerja data/DDL pakai user `dispar` (CH_PASSWORD).

# --- LLM, hanya bila menyentuh /ai ---
# OpenAI-compatible. Default kode: https://api.minimax.io/v1 + Minimax-M2.7.
LLM_URL=https://api.minimax.io/v1
LLM_MODEL=Minimax-M2.7
LLM_KEY=<key LLM kamu>

# --- Secret admin, hanya bila memanggil /api/admin/* ---
SYNC_SECRET=<Portainer stack 1 → SYNC_SECRET>
