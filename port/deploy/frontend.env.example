# Env frontend (Nuxt) untuk deploy/compose.yaml atau bare metal. Salin ke frontend.env lalu isi.
# Jangan pernah commit berkas yang sudah terisi.

# Alamat Laravel dari sisi server Nuxt (bukan dari browser). Di compose: service `backend` port 8080.
NUXT_LARAVEL_URL=http://backend:8080
# Token akun `frontend` (ability read) dari `php artisan portal:token frontend read`. Server-only.
NUXT_FRONTEND_TOKEN=<token-frontend>
# Base URL API Laravel yang ditampilkan di halaman /docs (publik, bukan rahasia).
NUXT_PUBLIC_API_BASE_URL=https://<domain-api-portal>
