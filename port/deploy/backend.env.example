# Env backend (Laravel) untuk deploy/compose.yaml atau .env bare metal. Salin ke backend.env lalu isi.
# Semua nilai bertanda <...> wajib diganti. Jangan pernah commit berkas yang sudah terisi.

APP_NAME="Portal Disparekraf"
APP_ENV=production
APP_DEBUG=false
# Keluaran `php artisan key:generate --show` (bentuk base64:...). Isi sekali, jangan diganti setelah tayang.
APP_KEY=
APP_URL=https://<domain-api-portal>

# Container: log ke stderr (dibaca `docker logs`). Bare metal boleh `daily` (storage/logs).
LOG_CHANNEL=stderr
LOG_LEVEL=info

# Oracle 19c milik server (SPEC §6). User = pemilik skema portal.
DB_CONNECTION=oracle
DB_HOST=<host-oracle>
DB_PORT=1521
DB_SERVICE_NAME=<service-name-oracle>
DB_SERVER_VERSION=12c
DB_USERNAME=<user-skema-portal>
DB_PASSWORD=<sandi-user-skema-portal>

# Cache Laravel di Oracle (SPEC §4.6); juga dipakai kunci withoutOverlapping scheduler.
CACHE_DRIVER=database

# Data API (lakehouse). Token = token layanan "kominfo", diserahkan langsung oleh pemilik.
DATA_API_URL=https://data-api.rantai.dev
DATA_API_TOKEN=<token-data-api>
# Bawaan sudah sesuai SPEC §4.6. Bila dinaikkan, naikkan juga timeout di deploy/backend/nginx.conf
# dan php-fpm.conf.
# DATA_API_TIMEOUT=10
# DATA_API_RETRY=2
# DATA_API_TIMEOUT_LAMBAT=60
# DATA_API_TIMEOUT_STREAM=300
# DATA_API_TIMEOUT_KESEHATAN=3

# Portal
PORTAL_VERSI=<versi-rilis>
# Alamat server Nuxt + semua reverse proxy/LB di depannya, dipisah koma (IP atau CIDR). Lihat README.
PORTAL_PROXY_TEPERCAYA=<ip-atau-cidr-nuxt>
PORTAL_BATAS_PER_MENIT=120
PORTAL_JAM_SINKRON=11:00
PORTAL_SNAPSHOT_BASI_JAM=36
PORTAL_CACHE_MENIT=15
LOG_HISTORY_AKTIF=true
LOG_HISTORY_RETENSI_HARI=180
