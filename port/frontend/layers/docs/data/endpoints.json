[
  {
    "id": "dataset-katalog",
    "method": "GET",
    "path": "/api/v1/katalog",
    "title": "Katalog dataset",
    "desc": "Dataset primer Satu Data Jakarta dan dataset sekunder Dinas, lengkap dengan lapisan lakehouse (medallion), statistik katalog, dan jumlah per lapisan. Dibaca dari snapshot harian.",
    "params": [
      {
        "name": "tier",
        "in": "query",
        "type": "semua | primer | sekunder | ",
        "required": false,
        "desc": "Tier dataset: semua (bawaan), primer (Satu Data Jakarta), atau sekunder."
      },
      {
        "name": "sumber",
        "in": "query",
        "type": "semua | sdi | internal | instansi | crawling | ",
        "required": false,
        "desc": "Sumber data: sdi, internal, instansi, atau crawling; semua = tanpa saringan."
      },
      {
        "name": "tag",
        "in": "query",
        "type": "string",
        "required": false,
        "desc": "Hanya dataset dengan tag ini."
      },
      {
        "name": "page",
        "in": "query",
        "type": "integer (≥ 1)",
        "required": false,
        "desc": "Nomor halaman, mulai 1."
      },
      {
        "name": "size",
        "in": "query",
        "type": "integer (1–500)",
        "required": false,
        "desc": "Jumlah baris per halaman."
      }
    ],
    "contoh": "/api/v1/katalog",
    "respons": "json",
    "errors": [
      {
        "code": "401",
        "when": "Token tidak ada atau tidak valid."
      },
      {
        "code": "422",
        "when": "Parameter tidak sesuai aturan (rincian per parameter di errors.fields)."
      }
    ]
  },
